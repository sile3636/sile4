local function toggleCameraLock()
    cameraLockActive = not cameraLockActive
    if cameraLockActive then
        lockedTarget = getClosestPlayer()
        if lockedTarget then
            createTargetIndicator(lockedTarget)
            if lockConn then lockConn:Disconnect() end
            lockConn = RunService.RenderStepped:Connect(function(dt)
                if not cameraLockActive or not lockedTarget or not lockedTarget.Parent then
                    cameraLockActive = false
                    removeTargetIndicator()
                    if lockConn then lockConn:Disconnect() end
                    MobileLockBtn.BackgroundColor3 = Color3.fromRGB(15, 20, 30)
                    mobStroke.Color = Color3.fromRGB(0, 255, 200)
                    return
                end
                Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, lockedTarget.Position), math.clamp(dt * 25, 0.1, 1))
            end)
            MobileLockBtn.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
            mobStroke.Color = Color3.fromRGB(255, 255, 255)
        else
            cameraLockActive = false
        end
    else
        cameraLockActive = false
        removeTargetIndicator()
        if lockConn then lockConn:Disconnect(); lockConn = nil end
        MobileLockBtn.BackgroundColor3 = Color3.fromRGB(15, 20, 30)
        mobStroke.Color = Color3.fromRGB(0, 255, 200)
    end
end

MobileLockBtn.MouseButton1Click:Connect(toggleCameraLock)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.E then
        toggleCameraLock()
    end
end)


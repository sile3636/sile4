createFeatureCard("🕊️ 3D Camera Fly", "Bay tự do theo hướng camera (Tốc độ cao)", function(btn, stroke)
    flyActive = not flyActive
    if flyActive then
        flyConn = RunService.RenderStepped:Connect(function()
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not hrp or not hum then return end
            hum.PlatformStand = true
            local moveDir = hum.MoveDirection
            if moveDir.Magnitude > 0 then
                hrp.AssemblyLinearVelocity = (Camera.CFrame.LookVector * moveDir.Z * -1 + Camera.CFrame.RightVector * moveDir.X).Unit * 60
            else
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end
        end)
        btn.Text = "ACTIVE"; btn.TextColor3 = Color3.fromRGB(0, 255, 100); stroke.Color = Color3.fromRGB(0, 255, 100)
    else
        if flyConn then flyConn:Disconnect(); flyConn = nil end
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hum then hum.PlatformStand = false end
            if hrp then hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end
        end
        btn.Text = "TOGGLE"; btn.TextColor3 = Color3.fromRGB(0, 255, 200); stroke.Color = Color3.fromRGB(0, 255, 200)
    end
end)


local fixLagActive = false
local originalStates = {}
local originalLightingProps = {}
local descendantConn = nil

createFeatureCard("🚀 Fix Lag Booster", "Tắt hiệu ứng, hạt & bóng đổ tối ưu FPS", function(btn, stroke)
    fixLagActive = not fixLagActive
    if fixLagActive then
        originalLightingProps.GlobalShadows = Lighting.GlobalShadows
        Lighting.GlobalShadows = false
        for _, child in ipairs(Lighting:GetChildren()) do
            if child:IsA("PostEffect") or child:IsA("BloomEffect") or child:IsA("BlurEffect") or child:IsA("SunRaysEffect") then
                originalLightingProps[child] = child.Enabled
                child.Enabled = false
            end
        end
        local function process(obj)
            if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") then
                if originalStates[obj] == nil then originalStates[obj] = obj.Enabled; obj.Enabled = false end
            end
        end
        for _, desc in ipairs(Workspace:GetDescendants()) do process(desc) end
        descendantConn = Workspace.DescendantAdded:Connect(process)
        btn.Text = "ACTIVE"; btn.TextColor3 = Color3.fromRGB(0, 255, 100); stroke.Color = Color3.fromRGB(0, 255, 100)
    else
        if descendantConn then descendantConn:Disconnect(); descendantConn = nil end
        Lighting.GlobalShadows = originalLightingProps.GlobalShadows or true
        for obj, state in pairs(originalLightingProps) do if obj and obj.Parent then obj.Enabled = state end end
        originalStates = {}
        btn.Text = "TOGGLE"; btn.TextColor3 = Color3.fromRGB(0, 255, 200); stroke.Color = Color3.fromRGB(0, 255, 200)
    end
end)

